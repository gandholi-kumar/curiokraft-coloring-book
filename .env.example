# ==============================================================================
# CurioKraft Engine Environment Configuration (Template)
# Copy this file to .env and insert your personal API keys.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# Google Gemini API Key (Recommended for AI image generation)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional fallback for DALL-E 3)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (Optional for Claude agent debates)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Engine Default Provider (mock | gemini | openai)
CK_DEFAULT_PROVIDER=mock

# ==============================================================================
# 1. Active Working Environment (Local Docker Dev Stack or Cloud)
# ==============================================================================
# Database Connection (Docker PostgreSQL or SQLite: sqlite:///output/curiokraft.db)
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/curiokraft

# Object / Blob Storage (Docker MinIO or local filesystem)
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadminpassword
S3_BUCKET_NAME=curiokraft-assets
S3_REGION=us-east-1

# ==============================================================================
# 2. Production Cloud Targets (Used by `curiokraft-book db push-to-cloud`)
# ==============================================================================
# Neon Serverless PostgreSQL
CLOUD_DATABASE_URL=postgresql+psycopg://neondb_owner:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# Backblaze B2 (S3-Compatible Object Storage)
CLOUD_STORAGE_BACKEND=s3
CLOUD_S3_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
CLOUD_S3_ACCESS_KEY_ID=your_backblaze_key_id
CLOUD_S3_SECRET_ACCESS_KEY=your_backblaze_application_key
CLOUD_S3_BUCKET_NAME=curiokraft-assets
CLOUD_S3_REGION=us-east-005
